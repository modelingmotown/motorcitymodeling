More model notes

---

Yep — below is a **single, reusable “bundle exporter”** that:

1. **Collects multiple models by name** (strings) and saves them **together** into either an **`.rds`** (recommended) *or* an **`.RData`** file.
2. **Also saves the data frames used for each model** (you can explicitly map model → df name; or it will try to infer from the model call).
3. Builds a **single CSV** that includes:

   * model name
   * dataframe name
   * timestamp (“date created” for the bundle; plus per-model timestamp)
   * **coefficients** (one row per term per model)
   * **SPSS-like summary metrics** (R, R², adj R², SEE, SS/df/MS/F/Sig, plus AIC/BIC/RMSE/MAE)

It’s designed primarily for `lm` models (since you’re matching SPSS).

---

## 1) The function

```r
save_model_bundle <- function(model_names,
                              bundle_path,
                              manifest_csv_path,
                              model_data_map = NULL,   # named character vec: c(modelA="dfA", modelB="dfB")
                              data_names = NULL,       # optional additional dfs to store (character vector)
                              format = c("rds", "RData"),
                              envir = parent.frame(),
                              overwrite = TRUE,
                              digits = 6) {
  format <- match.arg(format)

  # --- helpers ---------------------------------------------------------------
  .get_obj <- function(nm) {
    if (!exists(nm, envir = envir, inherits = TRUE)) {
      stop("Object not found in environment: ", nm, call. = FALSE)
    }
    get(nm, envir = envir, inherits = TRUE)
  }

  .infer_df_name_from_model <- function(mod) {
    # Attempt to infer from model$call$data (works for lm() with data=)
    cl <- tryCatch(mod$call, error = function(e) NULL)
    if (is.null(cl) || is.null(cl$data)) return(NA_character_)
    nm <- tryCatch(deparse(cl$data), error = function(e) NA_character_)
    nm
  }

  .safe_num <- function(x) {
    # ensure numeric scalar or NA_real_
    if (length(x) == 0) return(NA_real_)
    x <- suppressWarnings(as.numeric(x[1]))
    ifelse(is.finite(x), x, NA_real_)
  }

  .lm_metrics <- function(mod) {
    mf <- model.frame(mod)
    y  <- model.response(mf)
    e  <- residuals(mod)

    n <- length(y)
    df_res <- df.residual(mod)

    has_intercept <- attr(terms(mod), "intercept") == 1
    df_reg <- mod$rank - if (has_intercept) 1 else 0
    df_total <- n - 1

    sse <- sum(e^2)
    sst <- sum((y - mean(y))^2)
    ssr <- sst - sse

    msr <- ssr / df_reg
    mse <- sse / df_res

    f_stat <- msr / mse
    p_val  <- pf(f_stat, df_reg, df_res, lower.tail = FALSE)

    r2 <- 1 - sse / sst
    adj_r2 <- 1 - (1 - r2) * (df_total / df_res)
    r <- sqrt(max(r2, 0))
    see <- sqrt(mse)

    rmse <- sqrt(mean(e^2))
    mae  <- mean(abs(e))

    c(
      n = n,
      r = r,
      r_squared = r2,
      adj_r_squared = adj_r2,
      see = see,

      ss_regression = ssr,
      ss_residual   = sse,
      ss_total      = sst,

      df_regression = df_reg,
      df_residual   = df_res,
      df_total      = df_total,

      ms_regression = msr,
      ms_residual   = mse,

      f = f_stat,
      significance = p_val,

      sigma = summary(mod)$sigma,
      aic = AIC(mod),
      bic = BIC(mod),
      rmse = rmse,
      mae = mae
    )
  }

  .coef_table <- function(mod) {
    if (inherits(mod, "lm")) {
      sm <- summary(mod)$coefficients
      out <- data.frame(
        term = rownames(sm),
        estimate = sm[, 1],
        std_error = sm[, 2],
        t_value = sm[, 3],
        p_value = sm[, 4],
        row.names = NULL,
        check.names = FALSE
      )
      return(out)
    }

    # fallback if broom is available
    if (requireNamespace("broom", quietly = TRUE)) {
      td <- broom::tidy(mod)
      if (!all(c("term", "estimate") %in% names(td))) stop("broom::tidy() did not return expected columns.")
      # standardize a bit
      if (!"std_error" %in% names(td) && "std.error" %in% names(td)) td$std_error <- td$std.error
      if (!"t_value"   %in% names(td) && "statistic" %in% names(td)) td$t_value <- td$statistic
      if (!"p_value"   %in% names(td) && "p.value" %in% names(td)) td$p_value <- td$p.value
      keep <- intersect(c("term", "estimate", "std_error", "t_value", "p_value"), names(td))
      return(as.data.frame(td[, keep, drop = FALSE]))
    }

    stop("Model is not 'lm' and broom is not installed; cannot extract coefficients.")
  }

  .rbind_fill <- function(a, b) {
    # base R "bind_rows": union columns, fill missing with NA
    cols <- union(names(a), names(b))
    for (cc in setdiff(cols, names(a))) a[[cc]] <- NA
    for (cc in setdiff(cols, names(b))) b[[cc]] <- NA
    a <- a[, cols, drop = FALSE]
    b <- b[, cols, drop = FALSE]
    rbind(a, b)
  }

  # --- collect models ---------------------------------------------------------
  bundle_created_at <- Sys.time()

  models <- setNames(vector("list", length(model_names)), model_names)
  data_used <- list()

  model_rows <- NULL
  coef_rows  <- NULL

  for (mn in model_names) {
    mod <- .get_obj(mn)

    # attach a created_at attribute if not already present
    if (is.null(attr(mod, "created_at"))) attr(mod, "created_at") <- bundle_created_at

    # determine dataframe name for this model
    df_name <- NA_character_
    if (!is.null(model_data_map) && mn %in% names(model_data_map)) {
      df_name <- model_data_map[[mn]]
    } else {
      df_name <- .infer_df_name_from_model(mod)
    }

    # load dataframe object if we can
    df_obj <- NULL
    if (!is.na(df_name) && nzchar(df_name) && exists(df_name, envir = envir, inherits = TRUE)) {
      df_obj <- .get_obj(df_name)
      data_used[[df_name]] <- df_obj
    }

    models[[mn]] <- mod

    # metrics
    metrics <- NULL
    if (inherits(mod, "lm")) {
      metrics <- .lm_metrics(mod)
    } else if (requireNamespace("broom", quietly = TRUE)) {
      # glance fallback for non-lm models
      g <- broom::glance(mod)
      # keep a few common ones if they exist
      keep <- intersect(names(g), c("nobs", "r.squared", "adj.r.squared", "sigma", "AIC", "BIC"))
      metrics <- as.numeric(g[1, keep, drop = TRUE])
      names(metrics) <- keep
    } else {
      metrics <- c()
    }

    # coefficient table
    ct <- .coef_table(mod)

    # Build "model manifest row" (one per model)
    mrow <- data.frame(
      model_name = mn,
      data_name = ifelse(is.na(df_name), "", df_name),
      model_class = paste(class(mod), collapse = "/"),
      formula = if (inherits(mod, "lm")) deparse(formula(mod)) else "",
      created_at = format(attr(mod, "created_at"), tz = "UTC", usetz = TRUE),
      bundle_created_at = format(bundle_created_at, tz = "UTC", usetz = TRUE),
      stringsAsFactors = FALSE
    )

    if (length(metrics)) {
      for (k in names(metrics)) mrow[[k]] <- .safe_num(metrics[[k]])
    }

    # add model row to model_rows
    if (is.null(model_rows)) model_rows <- mrow else model_rows <- .rbind_fill(model_rows, mrow)

    # Build coefficient rows (one per term)
    crow <- ct
    crow$model_name <- mn
    crow$data_name  <- ifelse(is.na(df_name), "", df_name)
    crow$created_at <- format(attr(mod, "created_at"), tz = "UTC", usetz = TRUE)

    # also include selected model metrics per coefficient row (handy for filtering later)
    if (length(metrics)) {
      for (k in names(metrics)) crow[[k]] <- .safe_num(metrics[[k]])
    }

    # reorder
    front <- c("model_name", "data_name", "created_at", "term", "estimate", "std_error", "t_value", "p_value")
    rest  <- setdiff(names(crow), front)
    crow  <- crow[, c(front, rest), drop = FALSE]

    if (is.null(coef_rows)) coef_rows <- crow else coef_rows <- .rbind_fill(coef_rows, crow)
  }

  # include any additional dfs user asked to save
  if (!is.null(data_names)) {
    for (dn in data_names) {
      if (exists(dn, envir = envir, inherits = TRUE)) {
        data_used[[dn]] <- .get_obj(dn)
      } else {
        warning("data_names includes missing object: ", dn, call. = FALSE)
      }
    }
  }

  # --- Save the bundle --------------------------------------------------------
  bundle <- list(
    created_at = bundle_created_at,
    models = models,
    data = data_used,
    model_manifest = model_rows,
    coefficients = coef_rows
  )

  if (file.exists(bundle_path) && !overwrite) {
    stop("bundle_path exists and overwrite=FALSE: ", bundle_path, call. = FALSE)
  }

  if (format == "rds") {
    saveRDS(bundle, file = bundle_path)
  } else {
    # RData can save multiple objects; we save a single 'bundle' object for simplicity
    save(bundle, file = bundle_path)
  }

  # --- Create one CSV that contains BOTH sections ----------------------------
  # We'll stack them with a record_type column so it remains a single csv.
  model_csv <- model_rows
  model_csv$record_type <- "model"
  # add term/coef columns for alignment
  for (cc in c("term", "estimate", "std_error", "t_value", "p_value")) {
    if (!cc %in% names(model_csv)) model_csv[[cc]] <- NA
  }

  coef_csv <- coef_rows
  coef_csv$record_type <- "coefficient"

  # align and combine
  combined_csv <- model_csv
  combined_csv <- combined_csv[, c("record_type", setdiff(names(combined_csv), "record_type")), drop = FALSE]
  coef_csv     <- coef_csv[, c("record_type", setdiff(names(coef_csv), "record_type")), drop = FALSE]
  combined_csv <- .rbind_fill(combined_csv, coef_csv)

  # round numeric columns for readability in CSV
  num_cols <- vapply(combined_csv, is.numeric, logical(1))
  combined_csv[num_cols] <- lapply(combined_csv[num_cols], function(x) round(x, digits))

  utils::write.csv(combined_csv, file = manifest_csv_path, row.names = FALSE)

  invisible(list(
    bundle_path = bundle_path,
    manifest_csv_path = manifest_csv_path,
    bundle = bundle,
    combined_csv = combined_csv
  ))
}
```

