## A reusable “pre-predict patch” function (targets ln_garagespaces only)

This keeps your workflow clean:

```r
patch_ln_garagespaces <- function(model, newdata,
                                  var = "ln_garagespaces",
                                  method = c("train_median", "zero", "value"),
                                  value = 0) {
  method <- match.arg(method)

  if (!var %in% names(newdata)) {
    stop("newdata is missing column: ", var, call. = FALSE)
  }

  bad <- !is.finite(newdata[[var]])

  if (!any(bad)) return(newdata)

  fill <- switch(
    method,
    train_median = {
      tr <- model.frame(model)[[var]]
      median(tr[is.finite(tr)], na.rm = TRUE)
    },
    zero = 0,
    value = value
  )

  newdata[[var]][bad] <- fill
  newdata
}

nd <- newdata_from_sale2(data = cdf, model = mod_base, sale_col = "saleid", sale_id = 4782482)

nd <- patch_ln_garagespaces(mod_base, nd, method = "train_median")
pred <- predict(mod_base, newdata = nd)
pred
```

